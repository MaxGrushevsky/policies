{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm run build)",
      "Bash(npm run dev)",
      "Bash(npm run preview)",
      "Bash(node --test *)",
      "Bash(npx tsc --noEmit)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)"
    ],
    "ask": [
      "Bash(npm run build:android:prod *)",
      "Bash(npm run build:ios:prod *)",
      "Bash(git push *)"
    ],
    "deny": [
      "Read(**/secret/**)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/keystore.properties)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/google-services.json)",
      "Read(**/GoogleService-Info.plist)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-commit-junk.mjs\"",
            "timeout": 30,
            "statusMessage": "Проверка коммита на мусор"
          }
        ]
      }
    ]
  }
}
